APP_NAME=NaxaStudioBackend
APP_ENV=production
APP_DEBUG=false
APP_URL=https://naxastudio-backend.onrender.com
API_BASE_URL=https://naxastudio-backend.onrender.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/nexastudio?retryWrites=true&w=majority
# DATABASE_URL can be used instead of MONGODB_URI if your host provides that name.
# DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/nexastudio?retryWrites=true&w=majority
MONGODB_DB=nexastudio
ADMIN_API_KEY=change-this-only-if-you-need-to-read-leads
